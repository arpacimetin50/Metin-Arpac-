tom/film_meto_hikayeler.jpg`},{key:`karanfil`,baslik:`Karanfil Kokulu Ankara'm`,tur:`Kısa Belgesel`,aciklama:`Başkentin hafızasında iz bırakan sokaklar, insanlar ve anılar. Ankara'nın karanfil kokan nostaljik bir portresi.`,gorsel:`/images/custom/film_karanfil_ankara.jpg`},{key:`kederden`,baslik:`Kederden İrkilen Mevsimler`,tur:`Kısa Belgesel`,aciklama:`Mevsimlerin değişimiyle birlikte insanın iç dünyasındaki dönüşümü anlatan lirik bir belgesel.`,gorsel:`/images/custom/film_kederden_irkilen.jpg`},{key:`sahaf`,baslik:`Sahaf Günlüğü`,tur:`Kısa Belgesel`,aciklama:`Eski kitapların ve onları seven insanların dünyasına açılan bir kapı. Sahafların sessiz ama derin evreninden notlar.`,gorsel:`/images/custom/film_sahaf_gunlugu.jpg`},{key:`meslek`,baslik:`Meslek Günlüğü`,tur:`Kısa Belgesel`,aciklama:`Farklı mesleklerden insanların gündelik hayatlarına, emeklerine ve hayallerine yakın çekim bir bakış.`,gorsel:`/images/custom/film_meslek_gunlugu.jpg`}];function RY(){let{t:e}=ZB(`index`);return(0,G.jsx)(`section`,{id:`filmler`,className:`w-full bg-white py-10 border-b border-gray-100`,"data-dev-id":`src/pages/Index.tsx:90:4`,"data-dev-name":`section`,"data-dev-path":`src/pages/Index.tsx`,"data-dev-line":`90`,"data-dev-file":`Index.tsx`,"data-dev-component":`section`,children:(0,G.jsxs)(`div`,{className:`container mx-auto max-w-5xl px-4`,"data-dev-id":`src/pages/Index.tsx:91:6`,"data-dev-name":`div`,"data-dev-path":`src/pages/Index.tsx`,"data-dev-line":`91`,"data-dev-file":`Index.tsx`,"data-dev-component":`div`,children:[(0,G.jsx)(`h2`,{className:`text-base font-bold mb-6 pb-1 border-b-2`,style:{color:`#8B1A1A`,borderColor:`#8B1A1A`,fontFamily:`Verdana, Arial, sans-serif`},"data-dev-id":`src/pages/Index.tsx:92:8`,"data-dev-name":`h2`,"data-dev-path":`src/pages/Index.tsx`,"data-dev-line":`92`,"data-dev-file":`Index.tsx`,"data-dev-component":`h2`,children:e(`filmlerBaslik`,`FİLMLER`)}),(0,G.jsx)(`div`,{className:`grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6`,"data-dev-id":`